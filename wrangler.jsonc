{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finngabaree-com-astro-staging",
  "account_id": "7459bd2037d71d23fd030e3542b9df61",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "ENVIRONMENT": "staging",
    "SITE_HOST": "finngabaree.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  }
}
