---
import site from '../data/site.json';
import FamilySites from './FamilySites.astro';
---
<footer class="site-footer">
  <nav aria-label="Footer"><a href="/">Home</a><a href="/privacy">Privacy</a><a href="/sitemap">Sitemap</a><span data-analytics-settings hidden><button type="button" data-analytics-open aria-expanded="false" aria-controls="analytics-choices">Privacy choices</button></span></nav>
  <p>© {new Date().getUTCFullYear()} {site.name}</p>
  <FamilySites />
</footer>

<style>
  .site-footer > nav a,
  .site-footer > nav button {
    text-decoration: none;
  }

  .site-footer > nav a:hover,
  .site-footer > nav button:hover {
    text-decoration: underline;
  }
</style>
