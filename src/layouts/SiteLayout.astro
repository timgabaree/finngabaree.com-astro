---
import site from '../data/site.json';
import Seo from '../components/Seo.astro';
import Footer from '../components/Footer.astro';
import AnalyticsChoices from '../components/AnalyticsChoices.astro';
import '../styles/site.css';
interface Props { title?: string; description?: string; noindex?: boolean; }
const {title=site.title, description=site.description, noindex=false}=Astro.props;
const production=import.meta.env.PUBLIC_SITE_ENV==='production';
---
<!doctype html>
<html lang="en">
  <head><Seo title={title} description={description} noindex={noindex || !production} pathname={Astro.url.pathname} /></head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <main id="main-content" class="container" tabindex="-1"><slot /></main>
    <Footer />
    <AnalyticsChoices enableAnalytics={production} />
    <script is:inline src="/js/analytics.js" defer></script>
  </body>
</html>
